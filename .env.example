# Copy to `.env` and set to your deployed Cloudflare Worker URL.
# This is a public POST endpoint (not a secret), but keep it out of git anyway.
VITE_FORM_ENDPOINT=https://tfd-leads.your-subdomain.workers.dev

# Microsoft Clarity project id (Clarity dashboard → Settings → Overview).
# Analytics only load after the visitor accepts the cookie banner.
VITE_CLARITY_ID=xxxxxxxxxx

# Google Ads tag id (Ads → Goals → conversions → Google tag). Public, not secret.
# Loaded via gtag.js with Consent Mode v2 (ad storage denied until consent).
VITE_GADS_ID=AW-XXXXXXXXX
# Optional: the conversion "send_to" label for the lead/booking conversion.
VITE_GADS_LEAD_LABEL=AW-XXXXXXXXX/XxXxXxXxXx
